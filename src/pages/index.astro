</style>

<script>
  import { getTodayMinutes, subscribeFocus, formatMinutes } from '../lib/focus-system.js';

  document.addEventListener('DOMContentLoaded', () => {
    // 1. Live Hero Focus Today display
    const heroFocusEl = document.getElementById('hero-focus-today-mins');
    const tabFocusBeacon = document.getElementById('tab-focus-beacon');
    
    function refreshHeroFocus() {
      if (heroFocusEl) {
        const mins = getTodayMinutes();
        heroFocusEl.textContent = formatMinutes(mins);
      }
    }
    refreshHeroFocus();

    subscribeFocus((snap) => {
      refreshHeroFocus();
      if (tabFocusBeacon) {
        tabFocusBeacon.style.display = (snap && snap.running) ? 'inline-block' : 'none';
      }
    });

    // 2. View Switcher Controller (Segmented Control)
    const viewTabs = document.querySelectorAll<HTMLElement>('.segmented-tab');
    const headerNavBtns = document.querySelectorAll<HTMLElement>('.header-nav-btn');
    const views = {
      reviewers: document.getElementById('view-reviewers'),
      focus: document.getElementById('view-focus'),
      downloads: document.getElementById('view-downloads'),
    };

    function switchView(viewName: string, updateHash = true) {
      // Deactivate all tabs
      viewTabs.forEach((tab) => {
        const isMatch = tab.dataset.viewTab === viewName;
        tab.classList.toggle('active', isMatch);
        tab.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      });

      // Synchronize header nav buttons
      headerNavBtns.forEach((btn) => {
        btn.classList.toggle('active', btn.dataset.view === viewName);
      });

      // Toggle views visibility
      Object.entries(views).forEach(([key, el]) => {
        if (el) {
          el.style.display = key === viewName ? 'block' : 'none';
          el.classList.toggle('active', key === viewName);
        }
      });

      if (updateHash) {
        if (viewName === 'focus') window.location.hash = '#focus-timer';
        else if (viewName === 'downloads') window.location.hash = '#downloads';
        else history.replaceState(null, '', window.location.pathname);
      }
    }

    viewTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.viewTab || 'reviewers';
        switchView(target);
      });
    });

    // Handle hash on initial load
    if (window.location.hash === '#focus-timer') {
      switchView('focus', false);
    } else if (window.location.hash === '#downloads') {
      switchView('downloads', false);
    } else {
      switchView('reviewers', false);
    }

    // 3. Search and Subject Filtering
    const filterTabs = document.querySelectorAll<HTMLElement>('.filter-tab');
    const searchInput = document.getElementById('subject-search') as HTMLInputElement;
    const searchClearBtn = document.getElementById('search-clear-btn');
    const searchCounter = document.getElementById('search-counter');
    const emptyState = document.getElementById('empty-search-state');
    const btnResetSearch = document.getElementById('btn-reset-search');
    const cards = document.querySelectorAll<HTMLElement>('.subject-card');

    let currentFilter = 'all';

    function updateVisibility() {
      const query = (searchInput?.value || '').toLowerCase().trim();
      let matchCount = 0;

      if (searchClearBtn) {
        searchClearBtn.style.display = query ? 'block' : 'none';
      }

      cards.forEach((card) => {
        const code = card.dataset.code || '';
        const status = card.dataset.status || '';
        const text = card.textContent?.toLowerCase() || '';

        // Filter tab match
        let tabMatch = false;
        if (currentFilter === 'all') {
          tabMatch = true;
        } else if (currentFilter === 'active') {
          tabMatch = status === 'active';
        } else if (currentFilter === 'upcoming') {
          tabMatch = status === 'upcoming';
        } else {
          tabMatch = code.toLowerCase() === currentFilter.toLowerCase();
        }

        // Search match
        const searchMatch = !query || text.includes(query);

        if (tabMatch && searchMatch) {
          card.style.display = 'flex';
          matchCount++;
        } else {
          card.style.display = 'none';
        }
      });

      // Update counter & empty state
      if (searchCounter) {
        if (query || currentFilter !== 'all') {
          searchCounter.textContent = `Showing ${matchCount} of ${cards.length}`;
          searchCounter.style.display = 'inline';
        } else {
          searchCounter.style.display = 'none';
        }
      }

      if (emptyState) {
        emptyState.style.display = matchCount === 0 ? 'flex' : 'none';
      }
    }

    filterTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        filterTabs.forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');
        currentFilter = tab.getAttribute('data-filter') || 'all';
        updateVisibility();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', updateVisibility);
      
      // Escape key clears search
      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          searchInput.value = '';
          updateVisibility();
          searchInput.blur();
        }
      });
    }

    if (searchClearBtn) {
      searchClearBtn.addEventListener('click', () => {
        if (searchInput) {
          searchInput.value = '';
          searchInput.focus();
          updateVisibility();
        }
      });
    }

    if (btnResetSearch) {
      btnResetSearch.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        currentFilter = 'all';
        filterTabs.forEach((t) => {
          t.classList.toggle('active', t.getAttribute('data-filter') === 'all');
        });
        updateVisibility();
      });
    }

    // 4. Back to Top Button
    const backToTopBtn = document.getElementById('back-to-top-btn');
    if (backToTopBtn) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 320) {
          backToTopBtn.classList.add('visible');
        } else {
          backToTopBtn.classList.remove('visible');
        }
      });

      backToTopBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  });
</script>
