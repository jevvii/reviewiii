---
import Layout from '../layouts/Layout.astro';
import SubjectCard from '../components/SubjectCard.astro';
import FocusTimer from '../components/FocusTimer.astro';
import { SUBJECTS, TOTAL_QUESTIONS, TOTAL_MODULES } from '../data/subjects';

const baseUrl = import.meta.env.BASE_URL;
const activeSubjects = SUBJECTS.filter((s) => s.status === 'active');
---

<Layout title="ReviewIII — Year III Computer Science Study Reviewer & Quiz Portal">
  <main class="container">
    <!-- Hero Section -->
    <section class="hero">
      <div class="tagline">
        <span class="sparkle">✦</span>
        <span>ReviewIII Study Portal &bull; Year III CS</span>
      </div>
      <h1 class="hero-title">Academic Review Hub</h1>
      <p class="hero-subtitle">
        Curated identification-type questionnaires with 4-choice distractors, comprehensive answer keys, embedded NotebookLM interactive quizzes, and integrated Pomodoro study tracking.
      </p>
      
      <div class="meta-strip">
        <div class="meta-pill">
          <strong>{TOTAL_QUESTIONS}</strong> Active Items
        </div>
        <div class="meta-pill">
          <strong>{TOTAL_MODULES}</strong> Ready Modules
        </div>
        <div class="meta-pill">
          <strong>{activeSubjects.length}</strong> Active Subjects
        </div>
        <div class="meta-pill">
          <strong>100%</strong> Rationales & Keys
        </div>
        <div class="meta-pill focus-feature-pill">
          <strong>⏱️ Pomodoro</strong> Study Tracking
        </div>
      </div>
    </section>

    <!-- Pomodoro Focus & Automatic Time Tracker Section -->
    <section class="focus-section" id="focus-timer">
      <div class="section-header">
        <div class="section-title-row">
          <span class="section-badge">Productivity System</span>
          <h2 class="section-title">Pomodoro Focus & Automatic Study Log</h2>
        </div>
        <p class="section-sub">
          25/5/15 minute interval cycles with continuous auto-advance loops, browser-resilient epoch timing, Web Audio synthesis chimes, and automatic attribution logging.
        </p>
      </div>

      <FocusTimer />
    </section>

    <!-- Interactive Filter & Search Controls -->
    <section class="controls-section" id="subjects">
      <div class="filter-tabs">
        <button class="filter-tab active" data-filter="all">All ({SUBJECTS.length})</button>
        <button class="filter-tab" data-filter="active">Active ({activeSubjects.length})</button>
        <button class="filter-tab" data-filter="NETC311">NETC311</button>
        <button class="filter-tab" data-filter="HMBY311">HMBY311</button>
        <button class="filter-tab" data-filter="ATFL311">ATFL311</button>
        <button class="filter-tab" data-filter="upcoming">Upcoming ({SUBJECTS.length - activeSubjects.length})</button>
        <a href="#focus-timer" class="filter-tab focus-tab-link">⏱️ Focus Timer</a>
      </div>

      <div class="search-box">
        <span class="search-icon">🔍</span>
        <input
          type="text"
          id="subject-search"
          placeholder="Search subjects, modules, topics..."
          aria-label="Search subjects"
        />
      </div>
    </section>

    <!-- Subjects Grid -->
    <section class="subjects-grid" id="subjects-container">
      {SUBJECTS.map((subject) => (
        <SubjectCard subject={subject} />
      ))}
    </section>

    <!-- Consolidated Sources & Downloads Section -->
    <section class="sources-section">
      <div class="section-header">
        <h2 class="section-title">Consolidated Downloads & Answer Keys</h2>
        <span class="section-sub">Offline PDF Questionnaires, Word DOCX, JSON Datasets, and Markdown</span>
      </div>

      <div class="sources-box">
        <div class="source-list">
          <!-- NETC311 Module 1 -->
          <div class="source-row">
            <div class="source-info">
              <span class="source-tag netc">NETC311</span>
              <div class="source-text">
                <span class="source-name">Module 1 — Networking Today Reviewer</span>
                <span class="source-meta">99 Identification Items &bull; Cisco CCNA ITN</span>
              </div>
            </div>
            <div class="file-badges">
              <a href={`${baseUrl}downloads/netc311/Module 1 - Networking Today - Questionnaire.pdf`} download class="download-pill">PDF</a>
              <a href={`${baseUrl}downloads/netc311/Module 1 - Networking Today - Questionnaire.docx`} download class="download-pill">DOCX</a>
              <a href={`${baseUrl}downloads/netc311/Module_1_NotebookLM_Quiz.json`} download class="download-pill">JSON</a>
              <a href={`${baseUrl}downloads/netc311/Module_1_NotebookLM_Quiz.md`} download class="download-pill">MD</a>
            </div>
          </div>

          <!-- NETC311 Module 2 -->
          <div class="source-row">
            <div class="source-info">
              <span class="source-tag netc">NETC311</span>
              <div class="source-text">
                <span class="source-name">Module 2 — Basic Switch & End Device Configuration Reviewer</span>
                <span class="source-meta">104 Identification Items &bull; Cisco CCNA ITN</span>
              </div>
            </div>
            <div class="file-badges">
              <a href={`${baseUrl}downloads/netc311/Module 2 - Basic Switch and End Device Configuration - Questionnaire.pdf`} download class="download-pill">PDF</a>
              <a href={`${baseUrl}downloads/netc311/Module 2 - Basic Switch and End Device Configuration - Questionnaire.docx`} download class="download-pill">DOCX</a>
              <a href={`${baseUrl}downloads/netc311/Module_2_NotebookLM_Quiz.json`} download class="download-pill">JSON</a>
              <a href={`${baseUrl}downloads/netc311/Module_2_NotebookLM_Quiz.md`} download class="download-pill">MD</a>
            </div>
          </div>

          <!-- HMBY311 Module 1 -->
          <div class="source-row">
            <div class="source-info">
              <span class="source-tag hmby">HMBY311</span>
              <div class="source-text">
                <span class="source-name">Module 1 — The Scientific Method & Basic Chemistry Reviewer</span>
                <span class="source-meta">152 Identification Items &bull; Human Biology</span>
              </div>
            </div>
            <div class="file-badges">
              <a href={`${baseUrl}downloads/hmby311/Module 1 - Human Biology - Scientific Method and Basic Chemistry.pdf`} download class="download-pill">PDF</a>
              <a href={`${baseUrl}downloads/hmby311/Module 1 - Human Biology - Scientific Method and Basic Chemistry.docx`} download class="download-pill">DOCX</a>
              <a href={`${baseUrl}downloads/hmby311/HMBY311_Module_1_Quiz.json`} download class="download-pill">JSON</a>
              <a href={`${baseUrl}downloads/hmby311/HMBY311_Module_1_Quiz.md`} download class="download-pill">MD</a>
            </div>
          </div>

          <!-- ATFL311 Module 1 -->
          <div class="source-row">
            <div class="source-info">
              <span class="source-tag atfl">ATFL311</span>
              <div class="source-text">
                <span class="source-name">Module 1 — Introduction to Automata Theory & Chomsky Hierarchy Reviewer</span>
                <span class="source-meta">40 Identification Items &bull; Automata Theory & Formal Languages</span>
              </div>
            </div>
            <div class="file-badges">
              <a href={`${baseUrl}downloads/atfl311/Module 1 - Introduction to Automata Theory - Questionnaire.pdf`} download class="download-pill">PDF</a>
              <a href={`${baseUrl}downloads/atfl311/Module 1 - Introduction to Automata Theory - Questionnaire.docx`} download class="download-pill">DOCX</a>
              <a href={`${baseUrl}downloads/atfl311/ATFL311_Module_1_Quiz.json`} download class="download-pill">JSON</a>
              <a href={`${baseUrl}downloads/atfl311/ATFL311_Module_1_Quiz.md`} download class="download-pill">MD</a>
            </div>
          </div>

          <!-- ATFL311 Module 2 -->
          <div class="source-row">
            <div class="source-info">
              <span class="source-tag atfl">ATFL311</span>
              <div class="source-text">
                <span class="source-name">Module 2 — Finite State Machines & Prerequisites Reviewer</span>
                <span class="source-meta">48 Identification Items &bull; Automata Theory & Formal Languages</span>
              </div>
            </div>
            <div class="file-badges">
              <a href={`${baseUrl}downloads/atfl311/Module 2 - Finite State Machines and Prerequisites - Questionnaire.pdf`} download class="download-pill">PDF</a>
              <a href={`${baseUrl}downloads/atfl311/Module 2 - Finite State Machines and Prerequisites - Questionnaire.docx`} download class="download-pill">DOCX</a>
              <a href={`${baseUrl}downloads/atfl311/ATFL311_Module_2_Quiz.json`} download class="download-pill">JSON</a>
              <a href={`${baseUrl}downloads/atfl311/ATFL311_Module_2_Quiz.md`} download class="download-pill">MD</a>
            </div>
          </div>

          <!-- ATFL311 Module 3 -->
          <div class="source-row">
            <div class="source-info">
              <span class="source-tag atfl">ATFL311</span>
              <div class="source-text">
                <span class="source-name">Module 3 — Deterministic Finite Automata (DFA) Reviewer</span>
                <span class="source-meta">41 Identification Items &bull; Automata Theory & Formal Languages</span>
              </div>
            </div>
            <div class="file-badges">
              <a href={`${baseUrl}downloads/atfl311/Module 3 - Deterministic Finite Automata - Questionnaire.pdf`} download class="download-pill">PDF</a>
              <a href={`${baseUrl}downloads/atfl311/Module 3 - Deterministic Finite Automata - Questionnaire.docx`} download class="download-pill">DOCX</a>
              <a href={`${baseUrl}downloads/atfl311/ATFL311_Module_3_Quiz.json`} download class="download-pill">JSON</a>
              <a href={`${baseUrl}downloads/atfl311/ATFL311_Module_3_Quiz.md`} download class="download-pill">MD</a>
            </div>
          </div>

          <!-- ATFL311 Module 4 -->
          <div class="source-row">
            <div class="source-info">
              <span class="source-tag atfl">ATFL311</span>
              <div class="source-text">
                <span class="source-name">Module 4 — Non-Deterministic Finite Automata (NFA) Reviewer</span>
                <span class="source-meta">45 Identification Items &bull; Automata Theory & Formal Languages</span>
              </div>
            </div>
            <div class="file-badges">
              <a href={`${baseUrl}downloads/atfl311/Module 4 - Non-Deterministic Finite Automata - Questionnaire.pdf`} download class="download-pill">PDF</a>
              <a href={`${baseUrl}downloads/atfl311/Module 4 - Non-Deterministic Finite Automata - Questionnaire.docx`} download class="download-pill">DOCX</a>
              <a href={`${baseUrl}downloads/atfl311/ATFL311_Module_4_Quiz.json`} download class="download-pill">JSON</a>
              <a href={`${baseUrl}downloads/atfl311/ATFL311_Module_4_Quiz.md`} download class="download-pill">MD</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Hero */
  .hero {
    margin-bottom: 2.5rem;
  }

  .tagline {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-accent-primary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.85rem;
  }

  .sparkle {
    font-size: 0.95rem;
  }

  .hero-title {
    font-size: clamp(2rem, 6vw, 3.2rem);
    font-weight: 200;
    letter-spacing: -0.03em;
    color: var(--color-text-main);
    line-height: 1.15;
    margin-bottom: 0.75rem;
  }

  .hero-subtitle {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    max-width: 680px;
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .meta-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .meta-pill {
    font-size: 0.76rem;
    color: var(--color-text-muted);
    background: var(--color-bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 4px 12px;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  .meta-pill strong {
    color: var(--color-accent-primary);
  }

  .focus-feature-pill {
    border-color: rgba(138, 154, 134, 0.3);
    background: rgba(138, 154, 134, 0.06);
  }

  /* Focus Section */
  .focus-section {
    margin-bottom: 3.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .section-title-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 0.35rem;
  }

  .section-badge {
    font-size: 0.7rem;
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-accent-primary);
    background: rgba(138, 154, 134, 0.1);
    border: 1px solid rgba(138, 154, 134, 0.25);
    padding: 2px 8px;
    border-radius: var(--radius-xs);
  }

  .section-title {
    font-size: 1.25rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--color-text-main);
  }

  .section-sub {
    font-size: 0.84rem;
    color: var(--color-text-muted);
    max-width: 640px;
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  /* Controls */
  .controls-section {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .filter-tabs {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 2px;
    max-width: 100%;
  }

  .filter-tabs::-webkit-scrollbar {
    display: none;
  }

  .filter-tab {
    background: var(--color-bg-surface);
    border: 1px solid var(--border-subtle);
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-weight: 500;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    flex-shrink: 0;
    text-decoration: none;
  }

  .filter-tab:hover {
    color: var(--color-text-main);
    border-color: var(--border-medium);
  }

  .filter-tab.active {
    background: var(--color-accent-primary);
    color: var(--color-text-inverse);
    font-weight: 600;
    border-color: var(--color-accent-primary);
  }

  .focus-tab-link {
    border-color: rgba(138, 154, 134, 0.25);
    color: var(--color-accent-primary);
  }

  .focus-tab-link:hover {
    background: rgba(138, 154, 134, 0.1);
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--color-bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 7px 12px;
    width: 100%;
    min-width: 0;
    transition: border-color 0.2s ease;
  }

  @media (min-width: 768px) {
    .search-box {
      width: auto;
      min-width: 280px;
    }
  }

  .search-box:focus-within {
    border-color: var(--color-accent-primary);
  }

  .search-icon {
    font-size: 0.8rem;
    opacity: 0.6;
  }

  #subject-search {
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-text-main);
    font-size: 0.82rem;
    width: 100%;
    font-family: inherit;
  }

  #subject-search::placeholder {
    color: var(--color-text-subtle);
  }

  /* Subjects Grid */
  .subjects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.35rem;
    margin-bottom: 3.5rem;
  }

  @media (max-width: 640px) {
    .subjects-grid {
      grid-template-columns: 1fr;
      gap: 1.15rem;
    }
  }

  /* Sources Section */
  .sources-section {
    margin-top: 1rem;
  }

  .sources-box {
    background: var(--color-bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.25rem;
  }

  .source-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .source-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    background: #000000;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    flex-wrap: wrap;
    gap: 10px;
    transition: border-color 0.2s ease;
  }

  .source-row:hover {
    border-color: var(--border-medium);
  }

  .source-info {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1 1 auto;
    min-width: 0;
  }

  .source-tag {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: var(--radius-xs);
    flex-shrink: 0;
  }

  .source-tag.netc {
    color: #8a9a86;
    background: rgba(138, 154, 134, 0.1);
    border: 1px solid rgba(138, 154, 134, 0.2);
  }

  .source-tag.hmby {
    color: #a89f91;
    background: rgba(168, 159, 145, 0.1);
    border: 1px solid rgba(168, 159, 145, 0.2);
  }

  .source-tag.atfl {
    color: #8a9a86;
    background: rgba(138, 154, 134, 0.1);
    border: 1px solid rgba(138, 154, 134, 0.2);
  }

  .source-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .source-name {
    font-size: 0.86rem;
    font-weight: 500;
    color: var(--color-text-main);
    word-break: break-word;
  }

  .source-meta {
    font-size: 0.74rem;
    color: var(--color-text-subtle);
  }

  .file-badges {
    display: flex;
    align-items: center;
    gap: 5px;
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .source-row {
      flex-direction: column;
      align-items: stretch;
      padding: 10px 12px;
    }
    .file-badges {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      width: 100%;
      text-align: center;
    }
  }
</style>

<script>
  // Client-side filtering & live search
  document.addEventListener('DOMContentLoaded', () => {
    const filterTabs = document.querySelectorAll<HTMLElement>('.filter-tab:not(.focus-tab-link)');
    const searchInput = document.getElementById('subject-search') as HTMLInputElement;
    const cards = document.querySelectorAll<HTMLElement>('.subject-card');

    let currentFilter = 'all';

    function updateVisibility() {
      const query = (searchInput?.value || '').toLowerCase().trim();

      cards.forEach((card) => {
        const code = card.dataset.code || '';
        const status = card.dataset.status || '';
        const text = card.textContent?.toLowerCase() || '';

        // Filter tab match
        let tabMatch = false;
        if (currentFilter === 'all') {
          tabMatch = true;
        } else if (currentFilter === 'active') {
          tabMatch = status === 'active';
        } else if (currentFilter === 'upcoming') {
          tabMatch = status === 'upcoming';
        } else {
          tabMatch = code.toLowerCase() === currentFilter.toLowerCase();
        }

        // Search match
        const searchMatch = !query || text.includes(query);

        if (tabMatch && searchMatch) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    filterTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        filterTabs.forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');
        currentFilter = tab.getAttribute('data-filter') || 'all';
        updateVisibility();
      });
    });

    searchInput?.addEventListener('input', updateVisibility);
  });
</script>
