---
import Layout from '../layouts/Layout.astro';
import SubjectCard from '../components/SubjectCard.astro';
import FocusTimer from '../components/FocusTimer.astro';
import { SUBJECTS, TOTAL_QUESTIONS, TOTAL_MODULES } from '../data/subjects';

const baseUrl = import.meta.env.BASE_URL;
const activeSubjects = SUBJECTS.filter((s) => s.status === 'active');
---

<Layout title="ReviewIII — Year III Computer Science Study Reviewer & Quiz Portal">
  <main class="container">
    <!-- Hero Section with Minimalist Bento Stats -->
    <section class="hero">
      <div class="tagline">
        <span class="sparkle">✦</span>
        <span>ReviewIII Study Portal &bull; Year III CS</span>
      </div>
      <h1 class="hero-title">Academic Review Hub</h1>
      <p class="hero-subtitle">
        Curated identification-type questionnaires with verified answer keys, interactive NotebookLM-style quiz players, and integrated Pomodoro study tracking.
      </p>

      <!-- Bento Metric Pods -->
      <div class="bento-strip">
        <div class="bento-tile">
          <div class="bento-tile-top">
            <span class="bento-label">Question Bank</span>
            <span class="bento-tag">Verified</span>
          </div>
          <div class="bento-value">{TOTAL_QUESTIONS}</div>
          <div class="bento-sub">NETC (203) &bull; ATFL (174) &bull; HMBY (152)</div>
        </div>

        <div class="bento-tile">
          <div class="bento-tile-top">
            <span class="bento-label">Ready Modules</span>
            <span class="bento-tag active-tag">Interactive</span>
          </div>
          <div class="bento-value">{TOTAL_MODULES}</div>
          <div class="bento-sub">Cisco CCNA &bull; Automata &bull; BioChem</div>
        </div>

        <div class="bento-tile focus-tile">
          <div class="bento-tile-top">
            <span class="bento-label">Focus Today</span>
            <span class="bento-tag focus-tag">Manila PST</span>
          </div>
          <div class="bento-value" id="hero-focus-today-mins">0m</div>
          <div class="bento-sub">Continuous Pomodoro Study Log</div>
        </div>

        <div class="bento-tile">
          <div class="bento-tile-top">
            <span class="bento-label">Curriculum</span>
            <span class="bento-tag">Year III</span>
          </div>
          <div class="bento-value">{activeSubjects.length} <span class="bento-unit">/ {SUBJECTS.length}</span></div>
          <div class="bento-sub">Active &bull; 4 Upcoming Tracks</div>
        </div>
      </div>
    </section>

    <!-- Sophisticated View Switcher (Segmented Control) -->
    <section class="view-controller-section">
      <div class="segmented-control" role="tablist" aria-label="Study Hub Views">
        <button
          type="button"
          class="segmented-tab active"
          role="tab"
          aria-selected="true"
          aria-controls="view-reviewers"
          data-view-tab="reviewers"
          id="tab-reviewers"
        >
          <span class="tab-icon">📚</span>
          <span class="tab-text">Course Reviewers</span>
          <span class="tab-badge">{activeSubjects.length} Active</span>
        </button>

        <button
          type="button"
          class="segmented-tab"
          role="tab"
          aria-selected="false"
          aria-controls="view-focus"
          data-view-tab="focus"
          id="tab-focus"
        >
          <span class="tab-icon">⏱️</span>
          <span class="tab-text">Pomodoro Workstation</span>
          <span class="tab-live-beacon" id="tab-focus-beacon" style="display: none;"></span>
        </button>

        <button
          type="button"
          class="segmented-tab"
          role="tab"
          aria-selected="false"
          aria-controls="view-downloads"
          data-view-tab="downloads"
          id="tab-downloads"
        >
          <span class="tab-icon">📥</span>
          <span class="tab-text">Download Vault</span>
          <span class="tab-badge">36 Files</span>
        </button>
      </div>
    </section>

    <!-- VIEW 1: Course Reviewers (Default) -->
    <div class="hub-view active" id="view-reviewers" role="tabpanel" aria-labelledby="tab-reviewers">
      <!-- Sticky Filter & Search Toolbar -->
      <section class="controls-section" id="subjects">
        <div class="filter-tabs">
          <button class="filter-tab active" data-filter="all">All ({SUBJECTS.length})</button>
          <button class="filter-tab" data-filter="active">Active ({activeSubjects.length})</button>
          <button class="filter-tab" data-filter="NETC311">NETC311 (2)</button>
          <button class="filter-tab" data-filter="HMBY311">HMBY311 (3)</button>
          <button class="filter-tab" data-filter="ATFL311">ATFL311 (4)</button>
          <button class="filter-tab" data-filter="upcoming">Upcoming ({SUBJECTS.length - activeSubjects.length})</button>
        </div>

        <div class="search-box-wrapper">
          <div class="search-box">
            <span class="search-icon">🔍</span>
            <input
              type="text"
              id="subject-search"
              placeholder="Search subjects, modules, topics... (Press /)"
              aria-label="Search subjects and modules"
              autocomplete="off"
            />
            <button type="button" class="search-clear-btn" id="search-clear-btn" aria-label="Clear search" style="display: none;">✕</button>
            <kbd class="search-kbd-hint">/</kbd>
          </div>
          <span class="search-counter" id="search-counter" style="display: none;">Showing 7 of 7</span>
        </div>
      </section>

      <!-- Empty State for Search -->
      <div class="empty-search-state" id="empty-search-state" style="display: none;">
        <div class="empty-icon">🔍</div>
        <p class="empty-title">No matching subjects or modules found</p>
        <span class="empty-desc">Try adjusting your query or resetting your active filters.</span>
        <button type="button" class="btn-secondary" id="btn-reset-search">Reset Search & Filters</button>
      </div>

      <!-- Subjects Grid -->
      <section class="subjects-grid" id="subjects-container">
        {SUBJECTS.map((subject) => (
          <SubjectCard subject={subject} />
        ))}
      </section>
    </div>

    <!-- VIEW 2: Pomodoro Focus Workstation -->
    <div class="hub-view" id="view-focus" role="tabpanel" aria-labelledby="tab-focus" style="display: none;">
      <section class="focus-section-header">
        <div class="section-title-row">
          <span class="section-badge">Productivity Station</span>
          <h2 class="section-title">Pomodoro Focus & Study Log</h2>
        </div>
        <p class="section-sub">
          25/5/15 minute interval cycles with continuous auto-advance loops, browser-resilient epoch timing, Web Audio synthesis chimes, and automatic subject attribution logging.
        </p>
      </section>

      <FocusTimer />
    </div>

    <!-- VIEW 3: Download Vault -->
    <div class="hub-view" id="view-downloads" role="tabpanel" aria-labelledby="tab-downloads" style="display: none;">
      <section class="vault-section">
        <div class="section-header">
          <div class="section-title-row">
            <span class="section-badge">Offline Repository</span>
            <h2 class="section-title">Consolidated Downloads & Answer Keys</h2>
          </div>
          <span class="section-sub">
            Direct access to all 28 course documents: printable formatted PDFs, editable Word DOCX questionnaires, structured JSON datasets, and Markdown keys.
          </span>
        </div>

        <div class="sources-box">
          <div class="source-list">
            <!-- NETC311 Module 1 -->
            <div class="source-row">
              <div class="source-info">
                <span class="source-tag netc">NETC311</span>
                <div class="source-text">
                  <span class="source-name">Module 1 — Networking Today Reviewer</span>
                  <span class="source-meta">99 Identification Items &bull; Cisco CCNA ITN</span>
                </div>
              </div>
              <div class="file-badges">
                <a href={`${baseUrl}downloads/netc311/Module 1 - Networking Today - Questionnaire.pdf`} download class="download-pill" title="Download Printable PDF">PDF</a>
                <a href={`${baseUrl}downloads/netc311/Module 1 - Networking Today - Questionnaire.docx`} download class="download-pill" title="Download Word DOCX">DOCX</a>
                <a href={`${baseUrl}downloads/netc311/Module_1_NotebookLM_Quiz.json`} download class="download-pill" title="Download JSON Dataset">JSON</a>
                <a href={`${baseUrl}downloads/netc311/Module_1_NotebookLM_Quiz.md`} download class="download-pill" title="Download Markdown Key">MD</a>
              </div>
            </div>

            <!-- NETC311 Module 2 -->
            <div class="source-row">
              <div class="source-info">
                <span class="source-tag netc">NETC311</span>
                <div class="source-text">
                  <span class="source-name">Module 2 — Basic Switch & End Device Configuration Reviewer</span>
                  <span class="source-meta">104 Identification Items &bull; Cisco CCNA ITN</span>
                </div>
              </div>
              <div class="file-badges">
                <a href={`${baseUrl}downloads/netc311/Module 2 - Basic Switch and End Device Configuration - Questionnaire.pdf`} download class="download-pill" title="Download Printable PDF">PDF</a>
                <a href={`${baseUrl}downloads/netc311/Module 2 - Basic Switch and End Device Configuration - Questionnaire.docx`} download class="download-pill" title="Download Word DOCX">DOCX</a>
                <a href={`${baseUrl}downloads/netc311/Module_2_NotebookLM_Quiz.json`} download class="download-pill" title="Download JSON Dataset">JSON</a>
                <a href={`${baseUrl}downloads/netc311/Module_2_NotebookLM_Quiz.md`} download class="download-pill" title="Download Markdown Key">MD</a>
              </div>
            </div>

            <!-- HMBY311 Module 1 -->
            <div class="source-row">
              <div class="source-info">
                <span class="source-tag hmby">HMBY311</span>
                <div class="source-text">
                  <span class="source-name">Module 1 — The Scientific Method & Basic Chemistry Reviewer</span>
                  <span class="source-meta">152 Identification Items &bull; Human Biology</span>
                </div>
              </div>
              <div class="file-badges">
                <a href={`${baseUrl}downloads/hmby311/Module 1 - Human Biology - Scientific Method and Basic Chemistry.pdf`} download class="download-pill" title="Download Printable PDF">PDF</a>
                <a href={`${baseUrl}downloads/hmby311/Module 1 - Human Biology - Scientific Method and Basic Chemistry.docx`} download class="download-pill" title="Download Word DOCX">DOCX</a>
                <a href={`${baseUrl}downloads/hmby311/HMBY311_Module_1_Quiz.json`} download class="download-pill" title="Download JSON Dataset">JSON</a>
                <a href={`${baseUrl}downloads/hmby311/HMBY311_Module_1_Quiz.md`} download class="download-pill" title="Download Markdown Key">MD</a>
              </div>
            </div>

            <!-- HMBY311 Module 4 -->
            <div class="source-row">
              <div class="source-info">
                <span class="source-tag hmby">HMBY311</span>
                <div class="source-text">
                  <span class="source-name">Module 4 — Chromosomes & Cell Division Reviewer</span>
                  <span class="source-meta">40 Identification Items &bull; Human Biology</span>
                </div>
              </div>
              <div class="file-badges">
                <a href={`${baseUrl}downloads/hmby311/Module 4 - Human Biology - Chromosomes and Cell Division.pdf`} download class="download-pill" title="Download Printable PDF">PDF</a>
                <a href={`${baseUrl}downloads/hmby311/Module 4 - Human Biology - Chromosomes and Cell Division.docx`} download class="download-pill" title="Download Word DOCX">DOCX</a>
                <a href={`${baseUrl}downloads/hmby311/HMBY311_Module_4_Quiz.json`} download class="download-pill" title="Download JSON Dataset">JSON</a>
                <a href={`${baseUrl}downloads/hmby311/HMBY311_Module_4_Quiz.md`} download class="download-pill" title="Download Markdown Key">MD</a>
              </div>
            </div>

            <!-- HMBY311 Module 5 -->
            <div class="source-row">
              <div class="source-info">
                <span class="source-tag hmby">HMBY311</span>
                <div class="source-text">
                  <span class="source-name">Module 5 — Genetics, Human Inheritance and Cancer Reviewer</span>
                  <span class="source-meta">60 Identification Items &bull; Human Biology</span>
                </div>
              </div>
              <div class="file-badges">
                <a href={`${baseUrl}downloads/hmby311/Module 5 - Human Biology - Genetics Human Inheritance and Cancer.pdf`} download class="download-pill" title="Download Printable PDF">PDF</a>
                <a href={`${baseUrl}downloads/hmby311/Module 5 - Human Biology - Genetics Human Inheritance and Cancer.docx`} download class="download-pill" title="Download Word DOCX">DOCX</a>
                <a href={`${baseUrl}downloads/hmby311/HMBY311_Module_5_Quiz.json`} download class="download-pill" title="Download JSON Dataset">JSON</a>
                <a href={`${baseUrl}downloads/hmby311/HMBY311_Module_5_Quiz.md`} download class="download-pill" title="Download Markdown Key">MD</a>
              </div>
            </div>

            <!-- ATFL311 Module 1 -->
            <div class="source-row">
              <div class="source-info">
                <span class="source-tag atfl">ATFL311</span>
                <div class="source-text">
                  <span class="source-name">Module 1 — Introduction to Automata Theory & Chomsky Hierarchy</span>
                  <span class="source-meta">40 Identification Items &bull; Automata Theory & Formal Languages</span>
                </div>
              </div>
              <div class="file-badges">
                <a href={`${baseUrl}downloads/atfl311/Module 1 - Introduction to Automata Theory - Questionnaire.pdf`} download class="download-pill" title="Download Printable PDF">PDF</a>
                <a href={`${baseUrl}downloads/atfl311/Module 1 - Introduction to Automata Theory - Questionnaire.docx`} download class="download-pill" title="Download Word DOCX">DOCX</a>
                <a href={`${baseUrl}downloads/atfl311/ATFL311_Module_1_Quiz.json`} download class="download-pill" title="Download JSON Dataset">JSON</a>
                <a href={`${baseUrl}downloads/atfl311/ATFL311_Module_1_Quiz.md`} download class="download-pill" title="Download Markdown Key">MD</a>
              </div>
            </div>

            <!-- ATFL311 Module 2 -->
            <div class="source-row">
              <div class="source-info">
                <span class="source-tag atfl">ATFL311</span>
                <div class="source-text">
                  <span class="source-name">Module 2 — Finite State Machines & Prerequisites</span>
                  <span class="source-meta">48 Identification Items &bull; Automata Theory & Formal Languages</span>
                </div>
              </div>
              <div class="file-badges">
                <a href={`${baseUrl}downloads/atfl311/Module 2 - Finite State Machines and Prerequisites - Questionnaire.pdf`} download class="download-pill" title="Download Printable PDF">PDF</a>
                <a href={`${baseUrl}downloads/atfl311/Module 2 - Finite State Machines and Prerequisites - Questionnaire.docx`} download class="download-pill" title="Download Word DOCX">DOCX</a>
                <a href={`${baseUrl}downloads/atfl311/ATFL311_Module_2_Quiz.json`} download class="download-pill" title="Download JSON Dataset">JSON</a>
                <a href={`${baseUrl}downloads/atfl311/ATFL311_Module_2_Quiz.md`} download class="download-pill" title="Download Markdown Key">MD</a>
              </div>
            </div>

            <!-- ATFL311 Module 3 -->
            <div class="source-row">
              <div class="source-info">
                <span class="source-tag atfl">ATFL311</span>
                <div class="source-text">
                  <span class="source-name">Module 3 — Deterministic Finite Automata (DFA)</span>
                  <span class="source-meta">41 Identification Items &bull; Automata Theory & Formal Languages</span>
                </div>
              </div>
              <div class="file-badges">
                <a href={`${baseUrl}downloads/atfl311/Module 3 - Deterministic Finite Automata - Questionnaire.pdf`} download class="download-pill" title="Download Printable PDF">PDF</a>
                <a href={`${baseUrl}downloads/atfl311/Module 3 - Deterministic Finite Automata - Questionnaire.docx`} download class="download-pill" title="Download Word DOCX">DOCX</a>
                <a href={`${baseUrl}downloads/atfl311/ATFL311_Module_3_Quiz.json`} download class="download-pill" title="Download JSON Dataset">JSON</a>
                <a href={`${baseUrl}downloads/atfl311/ATFL311_Module_3_Quiz.md`} download class="download-pill" title="Download Markdown Key">MD</a>
              </div>
            </div>

            <!-- ATFL311 Module 4 -->
            <div class="source-row">
              <div class="source-info">
                <span class="source-tag atfl">ATFL311</span>
                <div class="source-text">
                  <span class="source-name">Module 4 — Non-Deterministic Finite Automata (NFA)</span>
                  <span class="source-meta">45 Identification Items &bull; Automata Theory & Formal Languages</span>
                </div>
              </div>
              <div class="file-badges">
                <a href={`${baseUrl}downloads/atfl311/Module 4 - Non-Deterministic Finite Automata - Questionnaire.pdf`} download class="download-pill" title="Download Printable PDF">PDF</a>
                <a href={`${baseUrl}downloads/atfl311/Module 4 - Non-Deterministic Finite Automata - Questionnaire.docx`} download class="download-pill" title="Download Word DOCX">DOCX</a>
                <a href={`${baseUrl}downloads/atfl311/ATFL311_Module_4_Quiz.json`} download class="download-pill" title="Download JSON Dataset">JSON</a>
                <a href={`${baseUrl}downloads/atfl311/ATFL311_Module_4_Quiz.md`} download class="download-pill" title="Download Markdown Key">MD</a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- Floating Back to Top Button -->
    <button type="button" class="back-to-top-btn" id="back-to-top-btn" title="Back to top" aria-label="Back to top">
      &uarr;
    </button>
  </main>
</Layout>

<style>
  /* Hero */
  .hero {
    margin-bottom: 2.5rem;
  }

  .tagline {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--color-accent-primary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.85rem;
  }

  .sparkle {
    font-size: 0.95rem;
  }

  .hero-title {
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    font-weight: 200;
    letter-spacing: -0.035em;
    color: var(--color-text-main);
    line-height: 1.15;
    margin-bottom: 0.75rem;
  }

  .hero-subtitle {
    font-size: 0.94rem;
    color: var(--color-text-muted);
    max-width: 680px;
    line-height: 1.65;
    margin-bottom: 1.75rem;
  }

  /* Bento Strip */
  .bento-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
  }

  .bento-tile {
    background: #0a0a0a;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: var(--radius-md);
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bento-tile:hover {
    border-color: rgba(255, 255, 255, 0.16);
    background: #0d0d0d;
    transform: translateY(-1px);
  }

  .bento-tile-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }

  .bento-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-subtle);
  }

  .bento-tag {
    font-size: 0.65rem;
    font-weight: 600;
    padding: 1px 6px;
    border-radius: var(--radius-xs);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    color: var(--color-text-subtle);
  }

  .bento-tag.active-tag {
    color: var(--color-accent-primary);
    border-color: rgba(138, 154, 134, 0.3);
    background: rgba(138, 154, 134, 0.08);
  }

  .bento-tag.focus-tag {
    color: var(--color-accent-secondary);
    border-color: rgba(168, 159, 145, 0.3);
    background: rgba(168, 159, 145, 0.08);
  }

  .bento-value {
    font-size: 1.85rem;
    font-weight: 600;
    color: var(--color-text-main);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 4px;
  }

  .bento-unit {
    font-size: 1rem;
    font-weight: 400;
    color: var(--color-text-subtle);
  }

  .bento-sub {
    font-size: 0.74rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* View Controller Segmented Bar */
  .view-controller-section {
    margin-bottom: 2rem;
    position: sticky;
    top: 57px;
    z-index: 40;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    padding: 8px 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .segmented-control {
    display: flex;
    gap: 6px;
    background: #0a0a0a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-full);
    padding: 4px;
    max-width: 680px;
    margin: 0 auto;
  }

  @media (max-width: 640px) {
    .segmented-control {
      max-width: 100%;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .segmented-control::-webkit-scrollbar {
      display: none;
    }
  }

  .segmented-tab {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: var(--radius-full);
    border: none;
    background: transparent;
    color: var(--color-text-muted);
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
    font-family: inherit;
  }

  .segmented-tab:hover {
    color: var(--color-text-main);
  }

  .segmented-tab.active {
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-text-main);
    font-weight: 600;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
  }

  .tab-badge {
    font-size: 0.68rem;
    padding: 1px 6px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-text-subtle);
    font-weight: 500;
  }

  .segmented-tab.active .tab-badge {
    background: rgba(138, 154, 134, 0.18);
    color: var(--color-accent-primary);
  }

  .tab-live-beacon {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-accent-primary);
    box-shadow: 0 0 6px var(--color-accent-primary);
    animation: pill-ping 1.5s infinite;
  }

  /* Hub Views */
  .hub-view {
    animation: view-fade-in 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes view-fade-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Focus Section View Header */
  .focus-section-header {
    margin-bottom: 2rem;
    text-align: center;
  }

  .focus-section-header .section-title-row {
    justify-content: center;
  }

  .focus-section-header .section-sub {
    margin: 0 auto;
  }

  /* Controls Toolbar */
  .controls-section {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .filter-tabs {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
