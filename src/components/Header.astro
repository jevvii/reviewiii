---
import { TOTAL_QUESTIONS, TOTAL_MODULES } from '../data/subjects';

interface Props {
  currentSubject?: string;
}

const { currentSubject } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<header class="site-header" id="site-header" data-base-url={baseUrl}>
  <div class="nav-container">
    <div class="nav-left">
      <a href={baseUrl} class="brand" title="ReviewIII Academic Hub">
        <span class="brand-sparkle">✦</span>
        <span class="brand-title">ReviewIII</span>
        <span class="brand-sub">Hub</span>
        {currentSubject && (
          <>
            <span class="crumb-divider">/</span>
            <span class="brand-crumb">{currentSubject}</span>
          </>
        )}
      </a>

      <!-- Quick Section Tabs (Desktop) -->
      <nav class="header-nav-links" aria-label="Main Navigation">
        <button type="button" class="header-nav-btn active" data-view="reviewers">
          Reviewers
        </button>
        <button type="button" class="header-nav-btn" data-view="focus">
          Pomodoro
        </button>
        <button type="button" class="header-nav-btn" data-view="downloads">
          Downloads
        </button>
      </nav>
    </div>

    <div class="nav-right">
      <!-- Quick Search Trigger Badge -->
      <button type="button" class="header-search-trigger" id="header-search-trigger" title="Quick Search (Press / to focus)">
        <span class="search-icon">🔍</span>
        <span class="search-label">Search</span>
        <kbd class="search-kbd">/</kbd>
      </button>

      <!-- Live Synchronized Focus Pill -->
      <button type="button" class="header-focus-pill idle" id="header-focus-pill" title="Jump to Pomodoro Focus Workstation">
        <span class="pill-ping" id="pill-ping-indicator" style="display: none;">
          <span class="ping-wave"></span>
          <span class="ping-dot"></span>
        </span>
        <span class="pill-icon" id="pill-phase-icon">⏱️</span>
        <span class="pill-text" id="pill-display-text">Focus</span>
      </button>

      <!-- GitHub Multi-User Profile & Session Switcher -->
      <div class="header-auth-wrapper" id="header-auth-wrapper">
        <button
          type="button"
          class="header-auth-pill"
          id="header-auth-pill"
          aria-expanded="false"
          aria-haspopup="true"
          title="GitHub Accounts & Isolated Sessions"
        >
          <span class="auth-pill-avatar-wrap" id="auth-pill-avatar-wrap">
            <svg class="github-icon-svg" viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
          </span>
          <span class="auth-pill-label" id="auth-pill-label">Sign in</span>
          <span class="auth-status-dot" id="auth-status-dot" style="display: none;"></span>
        </button>

        <!-- Dropdown Menu / Modal -->
        <div class="auth-dropdown" id="auth-dropdown" style="display: none;">
          <!-- Active Account Header -->
          <div class="auth-dropdown-header" id="auth-dropdown-header">
            <!-- Dynamically injected -->
          </div>

          <!-- Accounts Switcher List -->
          <div class="auth-section">
            <div class="auth-section-title">ACCOUNTS & SESSIONS</div>
            <div class="auth-accounts-list" id="auth-accounts-list">
              <!-- Dynamically injected -->
            </div>
          </div>

          <!-- Add GitHub Account Toggle & Form -->
          <div class="auth-section">
            <button type="button" class="auth-add-toggle-btn" id="auth-add-toggle-btn">
              <span>+ Connect GitHub Account</span>
              <span class="auth-toggle-chevron" id="auth-toggle-chevron">▾</span>
            </button>
            <form class="auth-login-form" id="auth-login-form" style="display: none;">
              <div class="auth-input-group">
                <label for="auth-github-username">GitHub Username</label>
                <div class="auth-input-wrap">
                  <span class="auth-input-prefix">@</span>
                  <input
                    type="text"
                    id="auth-github-username"
                    name="username"
                    placeholder="e.g. jevvii"
                    autocomplete="username"
                    required
                  />
                </div>
              </div>
              <div class="auth-input-group auth-token-group" style="display: none;" id="auth-token-group">
                <label for="auth-github-token">Personal Access Token (optional)</label>
                <input
                  type="password"
                  id="auth-github-token"
                  name="token"
                  placeholder="ghp_xxxxxxxxxxxx"
                  autocomplete="current-password"
                />
              </div>
              <div class="auth-form-footer">
                <button type="button" class="auth-pat-toggle-link" id="auth-pat-toggle-link">
                  Use PAT Token
                </button>
                <button type="submit" class="auth-submit-btn" id="auth-submit-btn">
                  Connect & Switch
                </button>
              </div>
              <div class="auth-error-msg" id="auth-error-msg" style="display: none;"></div>
            </form>
          </div>

          <!-- Dropdown Footer Actions -->
          <div class="auth-dropdown-footer">
            <button type="button" class="auth-footer-btn" id="auth-guest-mode-btn">
              <span>Guest Session</span>
            </button>
            <a
              href="https://github.com/jevvii/reviewiii"
              target="_blank"
              rel="noopener noreferrer"
              class="auth-repo-link"
              title="Open GitHub Repository"
            >
              Repo &nearr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .nav-left {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .crumb-divider {
    color: #444;
    font-size: 0.85rem;
  }
  .brand-crumb {
    color: var(--color-accent-primary);
    font-weight: 500;
  }

  /* Desktop Header Nav Links */
  .header-nav-links {
    display: none;
    align-items: center;
    gap: 4px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    padding: 3px;
  }

  @media (min-width: 860px) {
    .header-nav-links {
      display: flex;
    }
  }

  .header-nav-btn {
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    font-size: 0.78rem;
    font-weight: 500;
    padding: 5px 12px;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    font-family: inherit;
  }

  .header-nav-btn:hover {
    color: var(--color-text-main);
  }

  .header-nav-btn.active {
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-text-main);
    font-weight: 600;
    box-shadow: 0 1px 4px rgba(0,0,0,0.4);
  }

  /* Search Trigger */
  .header-search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    color: var(--color-text-muted);
    padding: 5px 10px;
    border-radius: var(--radius-sm);
    font-size: 0.76rem;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: inherit;
  }

  .header-search-trigger:hover {
    border-color: var(--border-medium);
    color: var(--color-text-main);
    background: rgba(255, 255, 255, 0.08);
  }

  .search-kbd {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 3px;
    padding: 0 5px;
    font-size: 0.68rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  @media (max-width: 640px) {
    .header-search-trigger .search-label {
      display: none;
    }
  }

  /* Header Focus Pill */
  .header-focus-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: var(--radius-full);
    font-size: 0.76rem;
    font-weight: 600;
    font-family: 'Inter', monospace;
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    transition: all 0.2s ease;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.04);
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .header-focus-pill.idle:hover {
    border-color: rgba(138, 154, 134, 0.4);
    color: var(--color-text-main);
    background: rgba(138, 154, 134, 0.08);
  }

  .header-focus-pill.running-focus {
    border-color: rgba(138, 154, 134, 0.5);
    background: rgba(138, 154, 134, 0.14);
    color: var(--color-accent-primary);
    box-shadow: 0 0 14px rgba(138, 154, 134, 0.22);
  }

  .header-focus-pill.running-break {
    border-color: rgba(168, 159, 145, 0.5);
    background: rgba(168, 159, 145, 0.14);
    color: #a89f91;
    box-shadow: 0 0 14px rgba(168, 159, 145, 0.22);
  }

  .pill-ping {
    position: relative;
    display: inline-flex;
    width: 8px;
    height: 8px;
  }

  .ping-wave {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background-color: currentColor;
    opacity: 0.6;
    animation: pill-ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  .ping-dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: currentColor;
  }

  @keyframes pill-ping {
    75%, 100% {
      transform: scale(2.2);
      opacity: 0;
    }
  }

  .pill-icon {
    font-size: 0.85rem;
  }

  /* -------------------------------------------------------------------------- */
  /* Multi-User GitHub Auth Header Styles                                      */
  /* -------------------------------------------------------------------------- */
  .header-auth-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .header-auth-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 12px;
    border-radius: var(--radius-full);
    font-size: 0.76rem;
    font-weight: 500;
    font-family: inherit;
    transition: all 0.2s ease;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.04);
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .header-auth-pill:hover {
    border-color: rgba(255, 255, 255, 0.25);
    color: var(--color-text-main);
    background: rgba(255, 255, 255, 0.08);
  }

  .header-auth-pill.logged-in {
    border-color: rgba(138, 154, 134, 0.4);
    background: rgba(138, 154, 134, 0.08);
    color: var(--color-text-main);
  }

  .header-auth-pill.logged-in:hover {
    border-color: rgba(138, 154, 134, 0.6);
    background: rgba(138, 154, 134, 0.15);
  }

  .auth-pill-avatar-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .auth-pill-avatar {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .auth-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #4ade80;
    box-shadow: 0 0 6px #4ade80;
  }

  /* Dropdown Modal */
  .auth-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: 310px;
    background: #0f1012;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 12px;
    padding: 14px;
    z-index: 1000;
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.75), 0 0 1px rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(20px);
    animation: authDropAnim 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes authDropAnim {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .auth-dropdown-header {
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .auth-profile-card {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .auth-profile-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(255, 255, 255, 0.2);
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.05);
  }

  .auth-profile-info {
    flex: 1;
    min-width: 0;
  }

  .auth-profile-name {
    font-size: 0.88rem;
    font-weight: 600;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .auth-profile-sub {
    font-size: 0.74rem;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 1px;
  }

  .auth-profile-sub a {
    color: var(--color-accent-primary);
    text-decoration: none;
  }

  .auth-profile-sub a:hover {
    text-decoration: underline;
  }

  .auth-badge-active {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.65rem;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: var(--radius-full);
    background: rgba(74, 222, 128, 0.12);
    color: #4ade80;
    border: 1px solid rgba(74, 222, 128, 0.25);
    margin-top: 6px;
  }

  .auth-badge-guest {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.65rem;
    font-weight: 500;
    padding: 2px 7px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-text-muted);
    border: 1px solid rgba(255, 255, 255, 0.1);
    margin-top: 6px;
  }

  .auth-section {
    margin-top: 12px;
  }

  .auth-section-title {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #777;
    margin-bottom: 6px;
  }

  .auth-accounts-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-height: 160px;
    overflow-y: auto;
  }

  .auth-account-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 8px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.15s ease;
    font-family: inherit;
    width: 100%;
    text-align: left;
  }

  .auth-account-item:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.1);
  }

  .auth-account-item.active {
    background: rgba(138, 154, 134, 0.1);
    border-color: rgba(138, 154, 134, 0.3);
  }

  .auth-account-item-left {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .auth-account-item-avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .auth-account-item-name {
    font-size: 0.78rem;
    font-weight: 500;
    color: #ddd;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .auth-account-item.active .auth-account-item-name {
    color: #fff;
    font-weight: 600;
  }

  .auth-account-item-right {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .auth-active-check {
    font-size: 0.7rem;
    color: #4ade80;
    font-weight: bold;
  }

  .auth-account-remove-btn {
    background: transparent;
    border: none;
    color: #666;
    font-size: 0.8rem;
    cursor: pointer;
    padding: 2px 4px;
    border-radius: 3px;
    line-height: 1;
  }

  .auth-account-remove-btn:hover {
    color: #f87171;
    background: rgba(248, 113, 113, 0.1);
  }

  .auth-add-toggle-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(255, 255, 255, 0.03);
    border: 1px dashed rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    padding: 7px 10px;
    font-size: 0.74rem;
    font-weight: 500;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: inherit;
  }

  .auth-add-toggle-btn:hover {
    color: var(--color-text-main);
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.06);
  }

  .auth-login-form {
    margin-top: 8px;
    padding: 10px;
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .auth-input-group {
    margin-bottom: 8px;
  }

  .auth-input-group label {
    display: block;
    font-size: 0.68rem;
    font-weight: 500;
    color: #888;
    margin-bottom: 3px;
  }

  .auth-input-wrap {
    display: flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 5px;
    overflow: hidden;
  }

  .auth-input-prefix {
    padding: 0 6px 0 8px;
    font-size: 0.75rem;
    color: #666;
  }

  .auth-input-wrap input,
  .auth-input-group input[type="password"] {
    width: 100%;
    background: transparent;
    border: none;
    outline: none;
    color: #fff;
    padding: 6px 8px;
    font-size: 0.78rem;
    font-family: inherit;
  }

  .auth-input-group input[type="password"] {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 5px;
  }

  .auth-input-wrap:focus-within,
  .auth-input-group input[type="password"]:focus {
    border-color: var(--color-accent-primary);
  }

  .auth-form-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 8px;
  }

  .auth-pat-toggle-link {
    background: none;
    border: none;
    color: #777;
    font-size: 0.68rem;
    cursor: pointer;
    padding: 0;
    text-decoration: underline;
  }

  .auth-pat-toggle-link:hover {
    color: #aaa;
  }

  .auth-submit-btn {
    background: var(--color-accent-primary);
    border: none;
    color: #0d0d0d;
    font-size: 0.74rem;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 5px;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .auth-submit-btn:hover {
    opacity: 0.9;
  }

  .auth-error-msg {
    margin-top: 6px;
    font-size: 0.68rem;
    color: #f87171;
    line-height: 1.3;
  }

  .auth-dropdown-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 10px;
    margin-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .auth-footer-btn {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--color-text-muted);
    font-size: 0.72rem;
    padding: 4px 8px;
    border-radius: 5px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .auth-footer-btn:hover {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.2);
  }

  .auth-repo-link {
    font-size: 0.72rem;
    color: var(--color-accent-primary);
    text-decoration: none;
  }

  .auth-repo-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 480px) {
    .header-focus-pill {
      padding: 4px 9px;
      font-size: 0.72rem;
    }

    .auth-dropdown {
      width: calc(100vw - 32px);
      right: -8px;
    }
  }
</style>

<script>
  import {
    readFocusSnapshot,
    subscribeFocus,
    formatTime,
    markInternalNav,
    PHASE_EMOJIS
  } from '../lib/focus-system.js';

  import {
    getActiveAccount,
    getAccounts,
    loginWithGitHub,
    switchAccount,
    removeAccount,
    subscribeAuth,
    GUEST_USER
  } from '../lib/auth-system.js';

  (function initHeader() {
    // ------------------------------------------------------------------------
    // 1. Pomodoro Focus Pill Synchronization
    // ------------------------------------------------------------------------
    const pillEl = document.getElementById('header-focus-pill');
    const pingEl = document.getElementById('pill-ping-indicator');
    const iconEl = document.getElementById('pill-phase-icon');
    const textEl = document.getElementById('pill-display-text');
    const searchTrigger = document.getElementById('header-search-trigger');
    const navBtns = document.querySelectorAll('.header-nav-btn');

    function updatePill(snap: any) {
      if (!pillEl) return;
      if (!snap || !snap.running) {
        pillEl.className = 'header-focus-pill idle';
        if (pingEl) pingEl.style.display = 'none';
        if (iconEl) iconEl.textContent = '⏱️';
        if (textEl) textEl.textContent = 'Focus';
        return;
      }

      const now = Date.now();
      const remaining = snap.endsAt ? Math.max(0, Math.ceil((snap.endsAt - now) / 1000)) : snap.secondsLeft;
      const isFocus = snap.phase === 'focus';

      pillEl.className = `header-focus-pill ${isFocus ? 'running-focus' : 'running-break'}`;
      if (pingEl) pingEl.style.display = 'inline-flex';
      if (iconEl) iconEl.textContent = PHASE_EMOJIS[snap.phase] || (isFocus ? '🎯' : '☕');
      if (textEl) textEl.textContent = `${formatTime(remaining)}`;
    }

    if (pillEl) {
      subscribeFocus(updatePill);
      updatePill(readFocusSnapshot());

      setInterval(() => {
        const snap = readFocusSnapshot();
        if (snap && snap.running) {
          updatePill(snap);
        }
      }, 1000);
    }

    const headerEl = document.getElementById('site-header');
    const baseUrl = headerEl?.getAttribute('data-base-url') || '/reviewiii/';

    // Pill click switches view to Focus Workstation
    pillEl?.addEventListener('click', () => {
      const focusTab = document.querySelector('[data-view-tab="focus"]') as HTMLElement;
      if (focusTab) {
        focusTab.click();
        const el = document.getElementById('view-focus');
        if (el) el.scrollIntoView({ behavior: 'smooth' });
      } else {
        markInternalNav();
        window.location.href = `${baseUrl}#focus-timer`;
      }
    });

    // Nav buttons click handlers
    navBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const view = btn.getAttribute('data-view');
        const targetTab = document.querySelector(`[data-view-tab="${view}"]`) as HTMLElement;
        if (targetTab) {
          targetTab.click();
          const targetSection = document.getElementById(`view-${view}`);
          if (targetSection) targetSection.scrollIntoView({ behavior: 'smooth' });
        } else {
          markInternalNav();
          window.location.href = `${baseUrl}#${view}`;
        }
      });
    });

    // Search Trigger click
    if (searchTrigger) {
      searchTrigger.addEventListener('click', () => {
        const revTab = document.querySelector('[data-view-tab="reviewers"]') as HTMLElement;
        if (revTab) {
          revTab.click();
          const searchInput = document.getElementById('subject-search') as HTMLInputElement;
          if (searchInput) {
            searchInput.focus();
            searchInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        } else {
          markInternalNav();
          window.location.href = `${baseUrl}?search=true#subjects`;
        }
      });
    }

    window.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
        e.preventDefault();
        searchTrigger?.click();
      }
    });

    // ------------------------------------------------------------------------
    // 2. Multi-User GitHub Auth & Isolated Session Manager
    // ------------------------------------------------------------------------
    const authPill = document.getElementById('header-auth-pill');
    const authDropdown = document.getElementById('auth-dropdown');
    const authPillLabel = document.getElementById('auth-pill-label');
    const authPillAvatarWrap = document.getElementById('auth-pill-avatar-wrap');
    const authStatusDot = document.getElementById('auth-status-dot');
    const authDropdownHeader = document.getElementById('auth-dropdown-header');
    const authAccountsList = document.getElementById('auth-accounts-list');
    const authAddToggleBtn = document.getElementById('auth-add-toggle-btn');
    const authLoginForm = document.getElementById('auth-login-form') as HTMLFormElement;
    const authUsernameInput = document.getElementById('auth-github-username') as HTMLInputElement;
    const authTokenInput = document.getElementById('auth-github-token') as HTMLInputElement;
    const authTokenGroup = document.getElementById('auth-token-group');
    const authPatToggleLink = document.getElementById('auth-pat-toggle-link');
    const authErrorMsg = document.getElementById('auth-error-msg');
    const authSubmitBtn = document.getElementById('auth-submit-btn');
    const authGuestModeBtn = document.getElementById('auth-guest-mode-btn');

    function renderAuthUI(activeUser = getActiveAccount()) {
      if (!authPill || !authPillLabel || !authPillAvatarWrap) return;

      const isGuest = !activeUser || activeUser.isGuest;

      // Update Pill
      if (isGuest) {
        authPill.className = 'header-auth-pill';
        authPillLabel.textContent = 'Sign in';
        if (authStatusDot) authStatusDot.style.display = 'none';
        authPillAvatarWrap.innerHTML = `
          <svg class="github-icon-svg" viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        `;
      } else {
        authPill.className = 'header-auth-pill logged-in';
        authPillLabel.textContent = `@${activeUser.username}`;
        if (authStatusDot) authStatusDot.style.display = 'inline-block';
        authPillAvatarWrap.innerHTML = `
          <img src="${activeUser.avatarUrl}" alt="${activeUser.username}" class="auth-pill-avatar" />
        `;
      }

      // Update Dropdown Header
      if (authDropdownHeader) {
        if (isGuest) {
          authDropdownHeader.innerHTML = `
            <div class="auth-profile-card">
              <div class="auth-profile-avatar" style="display:flex;align-items:center;justify-content:center;font-size:1.2rem;">
                👤
              </div>
              <div class="auth-profile-info">
                <div class="auth-profile-name">Guest Student</div>
                <div class="auth-profile-sub">Anonymous Session</div>
                <span class="auth-badge-guest">⚡ Local Browser Storage</span>
              </div>
            </div>
          `;
        } else {
          authDropdownHeader.innerHTML = `
            <div class="auth-profile-card">
              <img src="${activeUser.avatarUrl}" alt="${activeUser.username}" class="auth-profile-avatar" />
              <div class="auth-profile-info">
                <div class="auth-profile-name">${activeUser.displayName || activeUser.username}</div>
                <div class="auth-profile-sub">
                  <a href="${activeUser.profileUrl}" target="_blank" rel="noopener noreferrer">@${activeUser.username} &nearr;</a>
                </div>
                <span class="auth-badge-active">● Active GitHub Session</span>
              </div>
            </div>
          `;
        }
      }

      // Update Accounts List
      if (authAccountsList) {
        const accounts = getAccounts();
        let html = '';

        // GitHub Accounts
        accounts.forEach((acc) => {
          const isActive = !isGuest && acc.id === activeUser.id;
          html += `
            <div class="auth-account-item ${isActive ? 'active' : ''}" data-user-id="${acc.id}">
              <div class="auth-account-item-left">
                <img src="${acc.avatarUrl}" alt="${acc.username}" class="auth-account-item-avatar" />
                <span class="auth-account-item-name">@${acc.username}</span>
              </div>
              <div class="auth-account-item-right">
                ${isActive ? '<span class="auth-active-check">Active ✓</span>' : ''}
                <button type="button" class="auth-account-remove-btn" data-remove-id="${acc.id}" title="Remove account from device">✕</button>
              </div>
            </div>
          `;
        });

        // Guest Session Item
        html += `
          <div class="auth-account-item ${isGuest ? 'active' : ''}" data-user-id="guest">
            <div class="auth-account-item-left">
              <span style="font-size: 1.1rem; width: 24px; text-align: center;">👤</span>
              <span class="auth-account-item-name">Guest Session</span>
            </div>
            <div class="auth-account-item-right">
              ${isGuest ? '<span class="auth-active-check">Active ✓</span>' : ''}
            </div>
          </div>
        `;

        authAccountsList.innerHTML = html;

        // Attach Click Handlers to Account Items
        const items = authAccountsList.querySelectorAll('.auth-account-item');
        items.forEach((item) => {
          item.addEventListener('click', (e) => {
            const target = e.target as HTMLElement;
            if (target && target.classList.contains('auth-account-remove-btn')) return;
            const targetId = item.getAttribute('data-user-id');
            if (targetId && targetId !== activeUser.id) {
              switchAccount(targetId);
              closeDropdown();
            }
          });
        });

        // Attach Click Handlers to Remove Buttons
        const removeBtns = authAccountsList.querySelectorAll('.auth-account-remove-btn');
        removeBtns.forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const removeId = btn.getAttribute('data-remove-id');
            if (removeId && confirm('Disconnect this GitHub account from ReviewIII on this device?')) {
              removeAccount(removeId);
            }
          });
        });
      }
    }

    // Toggle Dropdown
    function toggleDropdown() {
      if (!authDropdown) return;
      const isVisible = authDropdown.style.display !== 'none';
      if (isVisible) {
        closeDropdown();
      } else {
        renderAuthUI();
        authDropdown.style.display = 'block';
        authPill?.setAttribute('aria-expanded', 'true');
      }
    }

    function closeDropdown() {
      if (!authDropdown) return;
      authDropdown.style.display = 'none';
      authPill?.setAttribute('aria-expanded', 'false');
      if (authLoginForm) authLoginForm.style.display = 'none';
      if (authErrorMsg) authErrorMsg.style.display = 'none';
    }

    authPill?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleDropdown();
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!authDropdown || authDropdown.style.display === 'none') return;
      const target = e.target as HTMLElement;
      if (!target.closest('#header-auth-wrapper')) {
        closeDropdown();
      }
    });

    // Toggle Add Account Form
    authAddToggleBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!authLoginForm) return;
      const isHidden = authLoginForm.style.display === 'none';
      authLoginForm.style.display = isHidden ? 'block' : 'none';
      if (isHidden) {
        authUsernameInput?.focus();
      }
    });

    // Toggle PAT field
    authPatToggleLink?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!authTokenGroup) return;
      const isHidden = authTokenGroup.style.display === 'none';
      authTokenGroup.style.display = isHidden ? 'block' : 'none';
      authPatToggleLink.textContent = isHidden ? 'Hide PAT field' : 'Use PAT Token';
    });

    // Handle Login Form Submission
    authLoginForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const username = authUsernameInput?.value.trim();
      const token = authTokenInput?.value.trim();

      if (!username && !token) return;

      if (authSubmitBtn) {
        authSubmitBtn.setAttribute('disabled', 'true');
        authSubmitBtn.textContent = 'Connecting...';
      }
      if (authErrorMsg) authErrorMsg.style.display = 'none';

      try {
        await loginWithGitHub(username, token);
        authLoginForm.reset();
        authLoginForm.style.display = 'none';
        closeDropdown();
      } catch (err: any) {
        if (authErrorMsg) {
          authErrorMsg.textContent = err?.message || 'Failed to authenticate with GitHub.';
          authErrorMsg.style.display = 'block';
        }
      } finally {
        if (authSubmitBtn) {
          authSubmitBtn.removeAttribute('disabled');
          authSubmitBtn.textContent = 'Connect & Switch';
        }
      }
    });

    // Guest Mode button
    authGuestModeBtn?.addEventListener('click', () => {
      switchAccount('guest');
      closeDropdown();
    });

    // Subscribe to auth state updates
    subscribeAuth((user) => {
      renderAuthUI(user);
    });

    // Initial render
    renderAuthUI();
  })();
</script>
