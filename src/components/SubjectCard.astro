---
import type { Subject } from '../data/subjects';

interface Props {
  subject: Subject;
}

const { subject } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const totalSubjectItems = subject.modules.reduce((acc, m) => acc + m.itemCount, 0);
const allTopics = Array.from(new Set(subject.modules.flatMap((m) => m.topics)));
const courseUrl = `${baseUrl}courses/${subject.code.toLowerCase()}/`;
---

<article class="subject-card course-card" data-code={subject.code} data-status={subject.status}>
  <div class="card-inner">
    <!-- Header Meta -->
    <div class="card-header">
      <div class="header-meta">
        <div class="code-and-cat">
          <span class="code-badge" style={`border-color: ${subject.accentColor}; color: ${subject.accentColor};`}>
            {subject.code}
          </span>
          <span class="category-tag">{subject.tag}</span>
        </div>

        {subject.status === 'active' ? (
          <span class="status-pill active">
            <span class="status-beacon"></span>
            <strong>{subject.modules.length} {subject.modules.length === 1 ? 'Module' : 'Modules'}</strong> &bull; {totalSubjectItems} Qs
          </span>
        ) : (
          <span class="status-pill upcoming">✦ Upcoming Track</span>
        )}
      </div>

      <h2 class="subject-title">
        <a href={courseUrl} class="title-link" title={`View ${subject.title} Course Page`}>
          {subject.title}
        </a>
      </h2>
      <div class="subject-subtitle">{subject.subtitle}</div>
      <p class="subject-description">{subject.description}</p>
    </div>

    <!-- Middle: Modules & Topics Preview -->
    <div class="card-body">
      {subject.status === 'active' && subject.modules.length > 0 ? (
        <div class="modules-preview-box">
          <div class="preview-header">
            <span class="preview-title">Course Modules ({subject.modules.length})</span>
            <span class="term-tag">{subject.term}</span>
          </div>

          <div class="module-quick-rows">
            {subject.modules.map((mod) => (
              <a href={`${courseUrl}#module-${mod.number}`} class="module-quick-row" title={`View Module ${mod.number}: ${mod.title}`}>
                <div class="quick-row-left">
                  <span class="quick-mod-badge">M{mod.number}</span>
                  <span class="quick-mod-title">{mod.title}</span>
                </div>
                <div class="quick-row-right">
                  <span class="quick-item-count">{mod.itemCount} Qs</span>
                  <span class="quick-row-arrow">&rarr;</span>
                </div>
              </a>
            ))}
          </div>

          {allTopics.length > 0 && (
            <div class="topics-preview">
              <span class="topics-preview-label">Core Topics:</span>
              <div class="topics-pill-cluster">
                {allTopics.slice(0, 4).map((t) => (
                  <span class="topic-pill">{t}</span>
                ))}
                {allTopics.length > 4 && (
                  <span class="topic-pill more-pill">+{allTopics.length - 4} more</span>
                )}
              </div>
            </div>
          )}
        </div>
      ) : (
        <div class="upcoming-preview-box">
          <div class="upcoming-indicator">✦</div>
          <p class="upcoming-headline">Curriculum in authoring & verification</p>
          <span class="upcoming-term">{subject.term} &bull; {subject.category.toUpperCase()}</span>
        </div>
      )}
    </div>

    <!-- Footer: Primary Navigation & Quick Direct Links -->
    <div class="card-footer">
      <div class="nav-actions">
        <a href={courseUrl} class="btn-primary course-nav-btn" title={`Open ${subject.title} Dedicated Content Page`}>
          <span>{subject.status === 'active' ? 'Explore Course & Quizzes' : 'Curriculum Roadmap'}</span>
          <span class="btn-arrow">&rarr;</span>
        </a>

        {subject.status === 'active' && subject.modules.length > 0 && (
          <a
            href={`${baseUrl}${subject.modules[0].quizPath}`}
            class="btn-secondary quick-quiz-btn"
            title={`Launch Module 1 Quiz Directly (${subject.modules[0].itemCount} Questions)`}
          >
            <span>M1 Quiz</span>
            <span>⚡</span>
          </a>
        )}
      </div>

      <div class="card-foot-meta">
        {subject.status === 'active' ? (
          <span class="downloads-available-tag">
            <span class="tag-icon">📥</span>
            <span>{subject.modules.length * 4} Offline Files (PDF, DOCX, JSON, MD)</span>
          </span>
        ) : (
          <span class="upcoming-status-note">Check back for module release</span>
        )}
      </div>
    </div>
  </div>
</article>

<style>
  .subject-card {
    background: #0a0a0a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    width: 100%;
    min-width: 0;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    position: relative;
    overflow: hidden;
  }

  .subject-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
  }

  .subject-card:hover {
    border-color: rgba(138, 154, 134, 0.4);
    background: #0d0d0d;
    transform: translateY(-3px);
    box-shadow: 0 14px 38px rgba(0, 0, 0, 0.65), 0 0 24px rgba(138, 154, 134, 0.08);
  }

  .card-inner {
    padding: 1.65rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    gap: 1.4rem;
  }

  .header-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
  }

  .code-and-cat {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .code-badge {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid;
    padding: 3px 9px;
    border-radius: var(--radius-xs);
  }

  .category-tag {
    font-size: 0.72rem;
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .status-pill {
    font-size: 0.74rem;
    padding: 3px 10px;
    border-radius: var(--radius-full);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }

  .status-pill.active {
    background: rgba(138, 154, 134, 0.1);
    border: 1px solid rgba(138, 154, 134, 0.3);
    color: var(--color-text-main);
  }

  .status-beacon {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-accent-primary);
    box-shadow: 0 0 8px var(--color-accent-primary);
  }

  .status-pill.active strong {
    color: var(--color-accent-primary);
  }

  .status-pill.upcoming {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    color: var(--color-text-subtle);
  }

  .subject-title {
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--color-text-main);
    letter-spacing: -0.02em;
    margin-bottom: 0.3rem;
    line-height: 1.3;
  }

  .title-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .title-link:hover {
    color: var(--color-accent-primary);
  }

  .subject-subtitle {
    font-size: 0.86rem;
    color: var(--color-accent-secondary);
    margin-bottom: 0.8rem;
    font-weight: 400;
  }

  .subject-description {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Body / Preview Box */
  .card-body {
    flex: 1 1 auto;
  }

  .modules-preview-box {
    background: #000000;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-md);
    padding: 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .preview-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    margin-bottom: 0.1rem;
  }

  .preview-title {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent-secondary);
  }

  .term-tag {
    font-size: 0.68rem;
    color: var(--color-text-subtle);
  }

  .module-quick-rows {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .module-quick-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 7px 9px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius-xs);
    text-decoration: none;
    transition: all 0.15s ease;
    gap: 10px;
  }

  .module-quick-row:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.14);
    transform: translateX(2px);
  }

  .quick-row-left {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    flex: 1 1 auto;
  }

  .quick-mod-badge {
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--color-accent-primary);
    background: rgba(138, 154, 134, 0.12);
    border: 1px solid rgba(138, 154, 134, 0.25);
    padding: 2px 6px;
    border-radius: 3px;
    flex-shrink: 0;
  }

  .quick-mod-title {
    font-size: 0.82rem;
    color: var(--color-text-main);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .quick-row-right {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .quick-item-count {
    font-size: 0.72rem;
    color: var(--color-text-subtle);
    font-variant-numeric: tabular-nums;
  }

  .quick-row-arrow {
    font-size: 0.75rem;
    color: var(--color-text-subtle);
    transition: transform 0.15s ease;
  }

  .module-quick-row:hover .quick-row-arrow {
    transform: translateX(2px);
    color: var(--color-accent-primary);
  }

  /* Topics */
  .topics-preview {
    display: flex;
    flex-direction: column;
    gap: 4px;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    padding-top: 0.65rem;
  }

  .topics-preview-label {
    font-size: 0.66rem;
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .topics-pill-cluster {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .topic-pill {
    font-size: 0.68rem;
    color: var(--color-text-muted);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    padding: 2px 7px;
    border-radius: var(--radius-xs);
  }

  .topic-pill.more-pill {
    color: var(--color-text-subtle);
    border-style: dashed;
  }

  /* Upcoming Preview Box */
  .upcoming-preview-box {
    background: #000000;
    border: 1px dashed rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    padding: 1.75rem 1rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .upcoming-indicator {
    color: var(--color-accent-primary);
    font-size: 1rem;
    margin-bottom: 2px;
  }

  .upcoming-headline {
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  .upcoming-term {
    font-size: 0.72rem;
    color: var(--color-text-subtle);
  }

  /* Card Footer */
  .card-footer {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .course-nav-btn {
    flex: 1 1 auto;
    padding: 10px 16px;
    font-size: 0.86rem;
  }

  .btn-arrow {
    transition: transform 0.15s ease;
  }

  .course-nav-btn:hover .btn-arrow {
    transform: translateX(3px);
  }

  .quick-quiz-btn {
    flex: 0 0 auto;
    font-size: 0.82rem;
    padding: 10px 14px;
    gap: 4px;
  }

  .card-foot-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.72rem;
    color: var(--color-text-subtle);
  }

  .downloads-available-tag {
    display: flex;
    align-items: center;
    gap: 5px;
    color: var(--color-text-subtle);
  }

  .tag-icon {
    font-size: 0.8rem;
  }

  .upcoming-status-note {
    color: var(--color-text-subtle);
    font-style: italic;
  }

  /* Mobile Responsive Breakpoints */
  @media (max-width: 640px) {
    .card-inner {
      padding: 1.25rem 1rem;
      gap: 1.1rem;
    }

    .subject-title {
      font-size: 1.2rem;
    }

    .nav-actions {
      flex-direction: column;
      width: 100%;
    }

    .course-nav-btn,
    .quick-quiz-btn {
      width: 100%;
      min-height: 44px;
    }

    .quick-mod-title {
      max-width: 180px;
    }
  }
</style>
