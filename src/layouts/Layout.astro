---
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description?: string;
  currentSubject?: string;
}

const {
  title,
  description = "ReviewIII — 3rd Year Computer Science Comprehensive Study Reviewer & Interactive Quiz Portal.",
  currentSubject
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en" class="dark-theme">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    
    <!-- Preload Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- ReviewIII Zero-Guest Auth Gate Engine -->
    <script is:inline src={`${baseUrl}scripts/auth-system.js`}></script>
  </head>
  <body>
    <Header currentSubject={currentSubject} />
    
    <slot />

    <footer>
      <p>
        <strong>ReviewIII</strong> &bull; Third Year Computer Science Comprehensive Reviewer &bull;
        Powered by <a href="https://notebooklm.google.com" target="_blank" rel="noopener noreferrer">Google NotebookLM</a>
      </p>
    </footer>
  </body>
</html>
